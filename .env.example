# Optional. Without any of these the app still works end to end:
# a built-in reader understands shipment descriptions and History lives in the browser.

# Gemini key(s) for a smarter reader. Comma-separate several to spread the free-tier limits.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash

# Neon / Postgres connection string, after running schema.sql. Enables /api/bookings.
DATABASE_URL=
